#!/usr/bin/env bash
# Entry point for humans, hooks and MCP clients. Resolves symlinks so it can be linked into PATH.
# Node runs the TypeScript sources directly (type stripping), so there is no build step.
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
exec node "$DIR/src/cli.ts" "$@"
